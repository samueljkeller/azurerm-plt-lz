# Local .terraform directories
**/.terraform/*

# Terraform lockfile is kept for reproducibility
# .terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform variable value files that may contain sensitive data
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Backend configuration files (may contain credentials)
backend.tfvars
